# KU — Katolícka univerzita v Ružomberku, production (https://e-knihy.ku.sk). `npm run build:ku`,
# deployed by the `deploy-ku` job in .github/workflows/deploy.yml on push to `dev`. Local overrides (e.g. against the dev catalog): env/.env.ku.local (gitignored).
ELVIRA_BASE_URL=https://api.e-knihy.ku.sk
ELVIRA_CATALOG_ID=1863182a-4f2c-4932-b27f-7336156cb954
ELVIRA_THEME=ku
ELVIRA_UMAMI_SERVER=
ELVIRA_UMAMI_WEBSITE=

# Minimal instance: no extraction index, no embeddings, no assistant model, no Readium LCP server.
# These are the defaults until an administrator switches a feature in Administration › Features
# (catalog setting portal.features, EvilFlowersCatalog#212). Keys: src/features/features.ts.
ELVIRA_EXPERIMENTAL_FEATURES=false
ELVIRA_FEATURES=assistant=off,passageSearch=off,contentInsights=off,graph=off,lending=off,interop=off,themedFeed=off
ELVIRA_FEATURED_FEED_ID=

# Browser tracing (Faro) is off: KU has no receiver.
ELVIRA_FARO_URL=
