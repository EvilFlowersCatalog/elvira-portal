ELVIRA_BASE_URL=https://dev.evilflowers.elvira.stuba.sk
ELVIRA_CATALOG_ID=932beb16-3886-4941-b30d-38638b6b35df
ELVIRA_THEME=stu
ELVIRA_UMAMI_SERVER=https://analytics.elvira.stuba.sk
ELVIRA_UMAMI_WEBSITE=d6e6bbea-e2ff-4188-af51-21da2a212767

ELVIRA_EXPERIMENTAL_FEATURES=true
ELVIRA_FEATURED_FEED_ID=afe55681-b71b-4aee-8327-422fbce314e5

# Browser tracing (Grafana Faro, elvira-portal#39). Empty = off. The deployed dev build gets these
# from the GitHub Environment; the receiver only accepts the https://dev.elvira.stuba.sk origin,
# so local dev stays off. ELVIRA_FARO_URL=https://dev.elvira.stuba.sk/faro/collect
ELVIRA_FARO_URL=
ELVIRA_FARO_API_KEY=
ELVIRA_FARO_ENVIRONMENT=development
ELVIRA_FARO_SAMPLE_RATE=1

# Reader PDF loading (elvira-portal#63): range-load the catalog's signed stream_url instead of
# downloading the whole file first. Chunk size in bytes (default 262144); auto-fetch = fetch the rest
# in the background after the first page (default true).
ELVIRA_VIEWER_STREAMING=true
ELVIRA_VIEWER_RANGE_CHUNK_SIZE=
ELVIRA_VIEWER_AUTO_FETCH=