# The container image (`npm run build`, Dockerfile, elvira-portal#61): one build for every client.
# No client values here. Each deployment mounts /config.json with its ELVIRA_* keys (src/lib/config.ts),
# which override these defaults at runtime. Without a config.json the app is served with the STU
# theme (the default) and no catalog, so it cannot sign anyone in.
ELVIRA_BASE_URL=
ELVIRA_CATALOG_ID=
ELVIRA_THEME=stu
ELVIRA_UMAMI_SERVER=
ELVIRA_UMAMI_WEBSITE=
ELVIRA_EXPERIMENTAL_FEATURES=false
ELVIRA_FEATURES=
ELVIRA_FEATURED_FEED_ID=
ELVIRA_FARO_URL=
ELVIRA_FARO_API_KEY=
ELVIRA_FARO_ENVIRONMENT=
ELVIRA_FARO_SAMPLE_RATE=1
